# ---- Runtime ----
NODE_ENV=development
PORT=8000
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/deepdoc

# ---- Auth ----
# Generate with: openssl rand -base64 32   (must be at least 16 characters)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# ---- Gemini ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A model name can still appear in ListModels after it stops accepting calls
# from newly created keys. If analyses fail with 404 right after a key
# rotation, change this first.
GEMINI_MODEL=gemini-3.6-flash
# Ceiling on the total base64 payload per request. Gemini caps inline requests
# at 20 MB; evidence beyond this budget is skipped and reported in the result.
GEMINI_MAX_PAYLOAD_MB=18
# Attempts before a submission is marked failed.
ANALYSIS_MAX_ATTEMPTS=3

# ---- S3 ----
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Point at an S3-compatible store (MinIO, R2) instead of AWS. Leave both unset
# for real AWS — the SDK then resolves its endpoint from AWS_REGION.
# S3_ENDPOINT is what the server itself calls; in Kubernetes that is the
# in-cluster Service.
# S3_ENDPOINT=http://minio.deepdoc.svc.cluster.local:9000
# S3_PUBLIC_ENDPOINT is the host presigned download links are signed for.
# SigV4 signs the Host header, so a link signed for an in-cluster address is
# unreachable from a browser and no proxy can rewrite it. Defaults to
# S3_ENDPOINT when the server and the browser use the same address.
# S3_PUBLIC_ENDPOINT=https://files.example.com
# Path-style URLs (host/bucket/key). Required by MinIO, wrong for AWS.
# S3_FORCE_PATH_STYLE=false

# ---- Uploads ----
MAX_UPLOAD_MB=10
